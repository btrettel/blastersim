&springer
dt            = 1.0e-7 ! s
csv_output    = .false.
csv_frequency = 1

! barrel
d_barrel  = 13.0  ! mm
l_travel  = 500.0 ! mm
m_proj    = 1.1   ! g
p_fs_proj = 5.0   ! kPa
p_fd_proj = 2.0   ! kPa
vol_dead  = 20.0  ! mL

! plunger tube
d_plunger    = 30.0  ! mm
k            = 500.0 ! N/m
l_draw       = 200.0 ! mm
delta_pre    = 50.0  ! mm
m_plunger    = 30.0  ! g
m_spring     = 10.0  ! g
p_fs_plunger = 4.0   ! kPa
p_fd_plunger = 1.0   ! kPa
cor          = 0.5

! atmosphere
p_atm    = 100.0 ! kPa (optional, absolute)
temp_atm = 310.0 ! K (optional)

! flow restriction
d_e = 5.0   ! mm
b   = 0.528 ! unitless (optional)

! Experimental result
actual_v_muzzle = 60.0 ! m/s (optional)
actual_rc       = 1    ! (optional)
/
